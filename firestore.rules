rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, or deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared learning content: any signed-in user can read.
    // TODO: restrict writes to admins (e.g. `request.auth.token.admin == true` via a custom claim)
    // once the app has an admin role. Until then every signed-in user can edit content.
    match /grammar_lessons/{id} {
      allow read, write: if request.auth != null;
    }
    match /questions/{id} {
      allow read, write: if request.auth != null;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
