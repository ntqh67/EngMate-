rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, or deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }
    // Missing `published` is treated as legacy-published so the old 17 lessons/129 questions
    // remain readable without mutating existing production documents. New documents must set it.
    function isPublishedOrLegacy() {
      return resource.data.get('published', true) == true;
    }
    // New learner queries should include whereEqualTo("published", true).
    match /grammar_lessons/{id} {
      allow read: if isAdmin() || (request.auth != null && isPublishedOrLegacy());
      allow write: if isAdmin();
    }
    match /grammar_catalog/{id} {
      allow read: if isAdmin() || (request.auth != null && isPublishedOrLegacy());
      allow write: if isAdmin();
    }
    match /questions/{id} {
      allow read: if isAdmin() || (request.auth != null && isPublishedOrLegacy());
      allow write: if isAdmin();
    }
    // Each learner's own data (profile, notebook, flashcards, quiz history, ...): only the owner.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
